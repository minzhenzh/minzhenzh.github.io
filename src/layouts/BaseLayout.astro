---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal website of Minzhen Zhang.' } = Astro.props;
const fullTitle = title === 'Home' ? 'Minzhen Zhang' : `${title} · Minzhen Zhang`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <div class="mx-auto w-full max-w-page px-6 sm:px-8">
      <Nav />
    </div>
    <main class="mx-auto w-full max-w-page flex-1 px-6 pt-16 pb-24 text-lg leading-normal sm:px-8 sm:pt-20 sm:text-xl">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-page px-6 pb-8 font-sans text-[13px] text-muted sm:px-8">
      © {new Date().getFullYear()} Minzhen Zhang
    </footer>
  </body>
</html>
