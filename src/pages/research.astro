---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Heading from '../components/Heading.astro';
import Placeholder from '../components/Placeholder.astro';
import ItemList from '../components/ItemList.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getResearch } from '../lib/content';

const research = await getResearch();
---

<BaseLayout title="Research">
  <Section title="Research">
    <Placeholder label="research interests" />
    <Heading>Publications</Heading>
    {
      research.length > 0 ? (
        <ItemList>
          {research.map((entry) => (
            <PublicationItem entry={entry} />
          ))}
        </ItemList>
      ) : (
        <Placeholder label="publication list" />
      )
    }
  </Section>
</BaseLayout>
