---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Meta from '../../components/Meta.astro';
import LinkRow from '../../components/LinkRow.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, summary, year, tags, links } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <p class="font-sans text-[13px]"><a href="/projects/" class="prose-link text-muted">← Projects</a></p>
  <h1 class="mt-6 font-medium">{title}</h1>
  <p class="mt-2 text-muted">{summary}</p>
  <Meta>
    <span>{year}</span>
    {tags.map((tag) => <span>{tag}</span>)}
    <LinkRow links={links} />
  </Meta>
  <article class="prose mt-10">
    <Content />
  </article>
</BaseLayout>
