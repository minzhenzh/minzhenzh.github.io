---
// Project page for a work entry: header, overview figure, then the entry's
// Markdown body as a short blog-style write-up.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorList from '../../components/AuthorList.astro';
import LinkRow from '../../components/LinkRow.astro';
import { getWork } from '../../lib/content';
import { sketchRect } from '../../lib/sketch';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, authors, summary, label, year, image, imageAlt, video, links, underReview } = entry.data;
const { Content } = await render(entry);
const { paper, ...otherLinks } = links;
const frame = sketchRect(`${entry.id}-hero`, 160, 100);
---

<BaseLayout title={title} description={summary}>
  <article class="max-w-text">
    <a href="/#research" class="reveal font-sans text-[13px] text-muted transition-colors hover:text-fg" style="--reveal: 1">
      ← Research &amp; Projects
    </a>

    <header class="reveal mt-10" style="--reveal: 1">
      <p class="font-sans text-[13px] tracking-wide text-muted uppercase">{label} · {year}</p>
      <h1 class="mt-3 text-[1.75rem] leading-tight font-medium tracking-[-0.01em] sm:text-[2.125rem]">{title}</h1>
      {authors && <AuthorList authors={authors} class="mt-4 text-lg" />}
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-sans text-[14px]">
        {
          paper ? (
            <a href={paper} class="prose-link text-fg">
              PDF
            </a>
          ) : (
            underReview && (
              <span class="cursor-not-allowed text-muted opacity-60" aria-disabled="true" title="Available once the review is complete">
                PDF (under review)
              </span>
            )
          )
        }
        <LinkRow links={otherLinks} />
      </p>
    </header>

    {summary && <p class="reveal mt-10 text-xl leading-[1.35] tracking-[-0.01em] sm:text-2xl" style="--reveal: 2">{summary}</p>}

    {/* Demo entries skip the overview: the demo video sits at the top of their body. */}
    {
      !video && (
        <div class="reveal relative mt-10" style="--reveal: 3">
          <Image src={image} alt={imageAlt} widths={[800, 1600]} sizes="(min-width: 720px) 640px, 100vw" class="figure w-full bg-figure p-3" />
          <svg
            class="sketch-frame pointer-events-none absolute inset-0 h-full w-full overflow-visible"
            viewBox="0 0 160 100"
            preserveAspectRatio="none"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            aria-hidden="true"
          >
            {frame.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
          </svg>
        </div>
      )
    }

    <div class="prose reveal mt-12 text-lg leading-relaxed sm:text-xl" style="--reveal: 4">
      <Content />
    </div>
  </article>

  {/* Figures are small at text width; clicking one shows it full screen. */}
  <dialog class="figure-zoom" aria-label="Enlarged figure" data-figure-zoom>
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-figure-zoom]')!;
  const zoomed = dialog.querySelector('img')!;

  document.querySelectorAll<HTMLImageElement>('article img').forEach((img) => {
    const open = () => {
      // Markdown figures are served at full size; the overview's src is too.
      zoomed.src = img.src;
      zoomed.alt = img.alt;
      dialog.showModal();
    };
    img.classList.add('zoomable');
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `Enlarge figure: ${img.alt}`);
    img.addEventListener('click', open);
    img.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open();
      }
    });
  });

  // Escape closes the dialog natively; a click anywhere closes it too.
  dialog.addEventListener('click', () => dialog.close());

  // Post videos are written with preload="none" and a poster, no autoplay, so
  // nothing downloads up front. They play like GIFs only while on screen and
  // the tab is visible; with reduced motion they stay on the poster with controls.
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.prose video')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const onScreen = new Set<HTMLVideoElement>();

  const sync = (video: HTMLVideoElement) => {
    video.controls = reducedMotion.matches;
    if (reducedMotion.matches) return; // the reader starts it themselves
    if (onScreen.has(video) && !document.hidden) {
      video.play().catch(() => {}); // rejected if the browser blocks autoplay
    } else {
      video.pause();
    }
  };
  const syncAll = () => videos.forEach(sync);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) onScreen.add(video);
        else onScreen.delete(video);
        sync(video);
      }
    },
    { threshold: 0.25 },
  );
  videos.forEach((video) => observer.observe(video));
  document.addEventListener('visibilitychange', syncAll);
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) videos.forEach((video) => video.pause());
    syncAll();
  });
</script>
