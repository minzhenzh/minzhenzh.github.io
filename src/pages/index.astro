---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contacts from '../components/Contacts.astro';
import Heading from '../components/Heading.astro';
import InkTree from '../components/InkTree.astro';
import Placeholder from '../components/Placeholder.astro';
import Reaction from '../components/Reaction.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWork } from '../lib/content';

const work = await getWork();

// Teaching assistantships, newest first.
const teaching = [
  { code: 'CIS*3530', course: 'Database Systems & Concepts', term: 'Fall 2026', ongoing: true },
  { code: 'CIS*3490', course: 'The Analysis and Design of Computer Algorithms', term: 'Winter 2026' },
  { code: 'CIS*3190', course: 'Software for Legacy Systems', term: 'Winter 2026' },
];
---

<BaseLayout title="Home">
  <div class="space-y-6">
    {/* The intro gets the whole first screen (minus the header), so the work
        grid starts below the fold instead of competing with the intro. */}
    <div class="min-h-[calc(100svh-11rem)]">
      <div class="relative">
        <div class="max-w-text space-y-8 text-xl leading-[1.3] tracking-[-0.01em] lg:text-2xl">
          <p class="reveal font-medium" style="--reveal: 1">
            I’m an M.Sc. student in Computer Science at the University of Guelph, under the supervision of Professor <a href="http://socs.uoguelph.ca/~lliao01/" class="prose-link">Lizhi Liao</a>.
          </p>
          <p class="reveal relative" style="--reveal: 2" data-reactions>
            I’m interested in <Reaction icon="robot">AI agents</Reaction>, <Reaction icon="code">software engineering</Reaction>, <Reaction icon="cube">computer graphics</Reaction>, and <Reaction icon="gamepad">game development</Reaction>, particularly in <Reaction icon="planet">building virtual worlds and characters</Reaction>, and in understanding how people play and interact within them.
          </p>
          <Contacts class="reveal" style="--reveal: 3" />
        </div>
        {/* Fills the empty space beside the intro on wide screens. */}
        <InkTree class="pointer-events-none absolute -top-16 right-[6%] hidden h-[calc(100%+7.5rem)] w-auto xl:block" />
      </div>
    </div>

    {/* News: uncomment once there is something to announce.
    <Heading>News</Heading>
    <ul class="space-y-3">
      <li>
        <span class="font-sans text-[13px] text-muted">2026-10</span>
        <p>TODO: news item</p>
      </li>
    </ul>
    */}

    <section id="research" class="reveal scroll-mt-8" style="--reveal: 4">
      <Heading>Research &amp; Projects</Heading>
      {
        work.length > 0 ? (
          <ul class="mt-6 grid gap-x-10 gap-y-14 md:grid-cols-2">
            {work.map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </ul>
        ) : (
          <div class="mt-6">
            <Placeholder label="papers and projects" />
          </div>
        )
      }
    </section>

    <section id="teaching" class="reveal scroll-mt-8 pt-12" style="--reveal: 5">
      <Heading pen="pencil">Teaching</Heading>
      <p class="mt-6 text-muted">Teaching assistant, University of Guelph</p>
      <ul class="mt-4 max-w-text space-y-3">
        {
          teaching.map(({ code, course, term, ongoing }) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-6">
              <span>{course}</span>
              <span class="font-sans text-[13px] tracking-wide text-muted uppercase">
                {code} · {term}
                {ongoing && ' · ongoing'}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
