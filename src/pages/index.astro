---
import BaseLayout from '../layouts/BaseLayout.astro';
import Heading from '../components/Heading.astro';
import Placeholder from '../components/Placeholder.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWork } from '../lib/content';

const work = await getWork();
---

<BaseLayout title="Home">
  <div class="space-y-6">
    <div class="max-w-text space-y-6">
      <p class="font-medium">
        I’m an M.Sc. student in Computer Science at the University of Guelph, under the supervision of <a href="http://socs.uoguelph.ca/~lliao01/" class="prose-link">Lizhi Liao</a>.
      </p>
      <p>
        I’m interested in AI agents, software engineering, computer graphics, and game development, particularly in building virtual worlds and characters, and in understanding how people play and interact within them.
      </p>
    </div>

    {/* News: uncomment once there is something to announce.
    <Heading>News</Heading>
    <ul class="space-y-3">
      <li>
        <span class="font-sans text-[13px] text-muted">2026-10</span>
        <p>TODO: news item</p>
      </li>
    </ul>
    */}

    <section id="research" class="scroll-mt-8">
      <Heading>Research &amp; Projects</Heading>
      {
        work.length > 0 ? (
          <ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {work.map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </ul>
        ) : (
          <div class="mt-6">
            <Placeholder label="papers and projects" />
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
