---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contacts from '../components/Contacts.astro';
import Heading from '../components/Heading.astro';
import Placeholder from '../components/Placeholder.astro';
import WorkList from '../components/WorkList.astro';
import { getWork } from '../lib/content';

const work = await getWork();

// Teaching assistantships, newest first.
const teaching = [
  { code: 'CIS*3530', course: 'Database Systems & Concepts', term: 'Fall 2026', ongoing: true },
  { code: 'CIS*3490', course: 'The Analysis and Design of Computer Algorithms', term: 'Winter 2026' },
  { code: 'CIS*3190', course: 'Software for Legacy Systems', term: 'Winter 2026' },
];
---

<BaseLayout title="Home">
  {/* Intro: two paragraphs and the contacts row, nothing else. */}
  <div class="reveal max-w-[34em] space-y-6 pt-4 text-[15px] leading-[1.78] sm:pt-10 lg:text-[17px]" style="--reveal: 1">
    <p>
      I’m an M.Sc. student in Computer Science at the University of Guelph, under the supervision of Professor <a href="http://socs.uoguelph.ca/~lliao01/" class="prose-link">Lizhi Liao</a>.
    </p>
    <p>
      I’m interested in <span class="term">software engineering</span>, <span class="term">computer graphics</span>, and <span class="term">game development</span>, particularly in <span class="term">building virtual worlds and characters</span>, and in understanding how they work through hands-on projects.
    </p>
    <Contacts />
  </div>

  {/* News: uncomment once there is something to announce.
  <Heading>News</Heading>
  <ul class="space-y-3">
    <li>
      <span class="text-[13px] text-muted">2026-10</span>
      <p>TODO: news item</p>
    </li>
  </ul>
  */}

  <section id="research" class="reveal scroll-mt-8 pt-24 sm:pt-32" style="--reveal: 2">
    <Heading>Research &amp; Projects</Heading>
    {
      work.length > 0 ? (
        <div class="mt-8 sm:mt-10">
          <WorkList entries={work} />
        </div>
      ) : (
        <div class="mt-6">
          <Placeholder label="papers and projects" />
        </div>
      )
    }
  </section>

  <section id="teaching" class="reveal scroll-mt-8 pt-24 sm:pt-32" style="--reveal: 3">
    <Heading>Teaching</Heading>
    <p class="mt-2.5 text-[13.5px] text-muted">Teaching assistant, University of Guelph</p>
    <ul class="mt-6 max-w-[62em] space-y-2.5 text-[15px] lg:text-[17px]">
      {
        teaching.map(({ code, course, term, ongoing }) => (
          <li class="flex flex-wrap items-baseline gap-x-3 sm:flex-nowrap">
            <span class="basis-full sm:basis-auto">{course}</span>
            <span class="leader hidden sm:block" aria-hidden="true" />
            <span class="text-[13.5px] whitespace-nowrap text-muted">
              {code} · {term}
              {ongoing && (
                <>
                  {' · '}
                  <span class="text-accent">ongoing</span>
                </>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
