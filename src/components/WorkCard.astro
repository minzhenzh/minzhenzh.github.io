---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import AuthorList from './AuthorList.astro';
import Meta from './Meta.astro';
import LinkRow from './LinkRow.astro';
import { sketchRect } from '../lib/sketch';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { id } = Astro.props.entry;
const { title, authors, label, year, image, imageAlt, links } = Astro.props.entry.data;
// The figure and title open the entry's project page.
const href = `/work/${id}/`;
// The frame's viewBox matches the figure's 16:10 aspect, so the wobble isn't stretched.
const frame = sketchRect(id, 160, 100);
---

<li>
  <a href={href} class="group block">
    <div class="relative">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 960, 1440]}
        sizes="(min-width: 1440px) 680px, (min-width: 768px) 50vw, 100vw"
        class="figure aspect-[16/10] w-full bg-figure object-contain p-2 transition-opacity group-hover:opacity-85"
      />
      <svg
        class="sketch-frame pointer-events-none absolute inset-0 h-full w-full overflow-visible"
        viewBox="0 0 160 100"
        preserveAspectRatio="none"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        aria-hidden="true"
      >
        {frame.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
      </svg>
    </div>
    <h3 class="mt-4 text-xl leading-snug">
      <span class="marker-hover marker-low pen-pink">{title}</span>
    </h3>
  </a>
  {authors && <AuthorList authors={authors} class="mt-1 text-base" />}
  <Meta>
    <span class="tracking-wide uppercase">{label} · {year}</span>
    <LinkRow links={links} />
  </Meta>
</li>
