---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Meta from './Meta.astro';
import LinkRow from './LinkRow.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { title, label, year, image, imageAlt, links } = Astro.props.entry.data;
// The figure and title link to the most relevant link the entry has.
const primary = links.paper ?? links.demo ?? links.code ?? links.video;
const Wrapper = primary ? 'a' : 'div';
---

<li>
  <Wrapper href={primary} class="group block">
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 800]}
      sizes="(min-width: 640px) 300px, 100vw"
      class="aspect-[16/10] w-full rounded-sm border border-rule bg-bg object-cover transition-opacity group-hover:opacity-85"
    />
    <h3 class="mt-3 text-lg leading-snug">
      <span class:list={[primary && 'prose-link group-hover:decoration-fg']}>{title}</span>
    </h3>
  </Wrapper>
  <Meta>
    <span class="tracking-wide uppercase">{label} · {year}</span>
    <LinkRow links={links} />
  </Meta>
</li>
