---
import ThemeToggle from './ThemeToggle.astro';

// Teaching is hidden on phones, where the name leaves room for only one link.
const links = [
  { href: '/#research', label: 'Research & Projects' },
  { href: '/#teaching', label: 'Teaching', wide: true },
];

const normalize = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = normalize(Astro.url.pathname);
---

<header class="reveal flex items-baseline justify-between gap-4 pt-6 text-[13.5px] text-muted" style="--reveal: 0">
  <a href="/" class="text-[15px] font-bold whitespace-nowrap text-fg" aria-current={current === '/' ? 'page' : undefined}>Minzhen Zhang</a>
  <div class="flex items-baseline gap-5 sm:gap-10">
    <nav>
      <ul class="flex gap-5 sm:gap-10">
        {
          links.map(({ href, label, wide }) => (
            <li class:list={[wide && 'hidden sm:block']}>
              <a href={href} class="whitespace-nowrap transition-colors hover:text-fg">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
