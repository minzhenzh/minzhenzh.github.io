---
import { sketchLine } from '../lib/sketch';

// Section label with a hand-drawn stroke under it that draws in on load: the pink
// highlighter for Research & Projects, a graphite pencil line for anything else.
interface Props {
  pen?: 'pink' | 'pencil';
}

const { pen = 'pink' } = Astro.props;
const marker = sketchLine('heading', 100, 5, 1.2);
---

<h2 class="pt-6 font-sans text-[13px] tracking-wide text-muted uppercase">
  <span class="relative inline-block">
    <svg
      class:list={['marker-stroke pointer-events-none absolute bottom-0 -left-1 h-2 overflow-visible', pen === 'pencil' && 'marker-stroke-pencil']}
      viewBox="0 0 100 10"
      preserveAspectRatio="none"
      fill="none"
      aria-hidden="true"
    >
      <path d={marker} vector-effect="non-scaling-stroke" />
    </svg>
    <span class="relative"><slot /></span>
  </span>
</h2>
