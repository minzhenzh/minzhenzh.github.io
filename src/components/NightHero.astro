---
import Nav from './Nav.astro';

// How the hero meets the page in light mode (dark mode always fades into the navy page):
//   'dawn' — the night sky fades through soft light blue and a warm hint into the page
//   'card' — the hero is a rounded card with margins, sitting on the light page
const LIGHT_VARIANT: 'dawn' | 'card' = 'dawn';
---

<section class="hero" data-night-hero data-light-variant={LIGHT_VARIANT}>
  <div class="hero-night">
    <div class="relative z-10 mx-auto flex min-h-[92svh] w-full max-w-page flex-col px-6 sm:min-h-[44rem] sm:px-8 lg:min-h-[min(48rem,88svh)] lg:px-12">
      <Nav />
      <div class="hero-text max-w-text space-y-6 pt-14 pb-12 text-lg leading-normal sm:pt-20 sm:text-xl" data-hero-text>
        <slot />
      </div>
    </div>
  </div>
  <div class="hero-fade" data-hero-fade aria-hidden="true"></div>
  <!-- Positioned after the in-flow backgrounds so it paints above the sky, below the text. -->
  <canvas class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" data-hero-canvas></canvas>
</section>

<script>
  import { initNightHero } from '../scripts/night-hero';

  document.querySelectorAll<HTMLElement>('[data-night-hero]').forEach(initNightHero);
</script>
