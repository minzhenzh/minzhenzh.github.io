---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="mx-auto max-w-4xl px-4 py-12 sm:py-16">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  {intro && <p class="mt-3 text-muted">{intro}</p>}
  <div class="mt-8 space-y-6">
    <slot />
  </div>
</section>
