---
import type { CollectionEntry } from 'astro:content';
import Meta from './Meta.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, summary, year, tags } = entry.data;
---

<li>
  <a href={`/projects/${entry.id}/`} class="prose-link">{title}</a>
  <p class="mt-1 text-base text-muted">{summary}</p>
  <Meta>
    <span>{year}</span>
    {tags.map((tag) => <span>{tag}</span>)}
  </Meta>
</li>
